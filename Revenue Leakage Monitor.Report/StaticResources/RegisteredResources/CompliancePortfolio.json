{
  "name": "Compliance Portfolio",
  "dataColors": [
    "#1F3864",
    "#2E5090",
    "#9AA7BD",
    "#C0392B",
    "#E08E45",
    "#5B6472",
    "#7FA7D9",
    "#3B7A57"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B1F27",
  "tableAccent": "#1F3864",
  "good": "#3B7A57",
  "neutral": "#E08E45",
  "bad": "#C0392B",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3864"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#1F3864"
    },
    "label": {
      "fontFace": "Segoe UI",
      "color": "#5B6472"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F6FA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E7EF"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}