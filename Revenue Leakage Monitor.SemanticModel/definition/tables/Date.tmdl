table Date
	lineageTag: 67ff0759-0d40-437f-afdf-d53361b4fac6
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: feb6fe7f-f2dd-440c-8761-0648d803d30e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		formatString: 0
		lineageTag: bf5afd20-329a-47f0-8a17-5afe6e093a62
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column Quarter
		dataType: string
		lineageTag: ae9dff7b-6615-46d6-9a8c-73a8c32f26e2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	column 'Month Num'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3cf3ac42-f7a6-418d-b771-535aacd42687
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Num]

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: 7267c6b4-1aa4-49db-8775-d8f38cece922
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month Num'

		annotation SummarizationSetBy = Automatic

	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 0965fc1b-052e-4746-8eb0-a196315c2792
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Start]

		annotation SummarizationSetBy = Automatic

	column Year-Month
		dataType: string
		lineageTag: f73f2f2f-68fd-454a-a396-55c2a824e6c8
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year-Month]

		annotation SummarizationSetBy = Automatic

	partition Date = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2024, 1, 1 ), EOMONTH ( MAX ( time_entries[entry_date] ), 0 ) ),
				    "Year", YEAR ( [Date] ),
				    "Quarter", "Q" & QUARTER ( [Date] ),
				    "Month Num", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "mmm" ),
				    "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				    "Year-Month", FORMAT ( [Date], "yyyy-mm" )
				)

