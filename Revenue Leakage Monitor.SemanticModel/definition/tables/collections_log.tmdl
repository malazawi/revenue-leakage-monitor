	partition collections_log = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "collections_log.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty CSV cells become nulls before typing
				    Blanks = Table.TransformColumns(Headers, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"contact_id", type text}, {"invoice_id", type text}, {"contact_date", type date}, {"method", type text}, {"outcome", type text}, {"promised_date", type date}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

