	partition staff = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "staff.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty CSV cells become nulls before typing
				    Blanks = Table.TransformColumns(Headers, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"staff_id", type text}, {"staff_name", type text}, {"email", type text}, {"title", type text}, {"office", type text}, {"practice", type text}, {"standard_rate", Int64.Type}, {"monthly_target_hours", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

