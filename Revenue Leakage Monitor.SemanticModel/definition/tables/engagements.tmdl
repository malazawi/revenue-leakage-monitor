	partition engagements = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "engagements.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty CSV cells become nulls before typing
				    Blanks = Table.TransformColumns(Headers, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"engagement_id", type text}, {"client_id", type text}, {"engagement_name", type text}, {"practice", type text}, {"billing_partner_id", type text}, {"fee_type", type text}, {"agreed_discount_pct", type number}, {"start_date", type date}, {"end_date", type date}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

