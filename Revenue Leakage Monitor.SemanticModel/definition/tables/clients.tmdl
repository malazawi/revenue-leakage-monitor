	partition clients = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "clients.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty CSV cells become nulls before typing
				    Blanks = Table.TransformColumns(Headers, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"client_id", type text}, {"client_name", type text}, {"industry", type text}, {"region", type text}, {"payment_terms_days", Int64.Type}, {"ap_contact_name", type text}, {"ap_contact_email", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

