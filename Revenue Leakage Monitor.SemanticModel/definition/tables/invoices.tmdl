		summarizeBy: none
		sourceColumn: balance

		annotation SummarizationSetBy = Automatic

	column 'Days Outstanding' =
			IF (
			    invoices[balance] > 0,
			    DATEDIFF ( invoices[invoice_date], MAX ( time_entries[entry_date] ), DAY )
			)
		dataType: int64
		formatString: 0
		lineageTag: ea93ba9b-0c36-4ae5-ba80-0ae1f06f71a3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'AR Aging Bucket' =
			VAR d = invoices[Days Outstanding]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( d ), BLANK (),
			        d <= 30, "0-30",
			        d <= 60, "31-60",
			        d <= 90, "61-90",
			        d <= 120, "91-120",
			        "120+"
			    )
		dataType: string
		lineageTag: 6353beda-8ff1-496c-9b9e-9fa9a651043c
		summarizeBy: none
		sortByColumn: 'AR Aging Order'

		annotation SummarizationSetBy = Automatic

	column 'AR Aging Order' =
			VAR d = invoices[Days Outstanding]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( d ), BLANK (), d <= 30, 1, d <= 60, 2, d <= 90, 3, d <= 120, 4, 5 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 25a5b3f1-d0ca-4584-94f3-2ab142dfc54a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition invoices = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "invoices.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty CSV cells become nulls before typing
				    Blanks = Table.TransformColumns(Headers, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"invoice_id", type text}, {"engagement_id", type text}, {"client_id", type text}, {"invoice_date", type date}, {"due_date", type date}, {"standard_value", type number}, {"invoice_amount", type number}, {"write_off_amount", type number}, {"write_off_date", type date}}, "en-US"),
				    // cash applied to each invoice, from the payments query
				    Applied = Table.Group(Table.SelectRows(payments, each [applied_invoice_id] <> null), {"applied_invoice_id"},
				        {{"amount_applied", each List.Sum([amount]), type number}}),
				    Joined = Table.NestedJoin(Typed, {"invoice_id"}, Applied, {"applied_invoice_id"}, "pay", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "pay", {"amount_applied"}),
				    Zeros = Table.ReplaceValue(Expanded, null, 0, Replacer.ReplaceValue, {"amount_applied", "write_off_amount"}),
				    // open balance = billed - applied cash - write-offs
				    Balance = Table.AddColumn(Zeros, "balance", each Number.Round(List.Max({0, [invoice_amount] - [amount_applied] - [write_off_amount]}), 2), type number)
				in
				    Balance

	annotation PBI_ResultType = Table

